# Kopiera till .env.local och fyll i värdena från ditt Supabase-projekt
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-nyckel

# Valfritt. Används för länken i bekräftelsemailet vid registrering.
# Utelämnas den härleds origin från request-headers.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Passbyggaren. Utan nyckel går appen att köra, men prompt-rutan säger
# vad som saknas i stället för att svara med ett fel.
# ANTHROPIC_API_KEY=sk-ant-...

# Mejl från appen via Resend: inbjudningar, påminnelser om samtycke och
# aviseringar från kontaktformuläret. Utan dem kopierar coachen texten själv.
# Avsändaren måste ligga på en domän som är verifierad i Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Coachvy <noreply@din-doman.se>
# Valfritt: vart kontaktformulärets förfrågningar mejlas (annars site.email).
# CONTACT_NOTIFY_TO=du@din-doman.se
